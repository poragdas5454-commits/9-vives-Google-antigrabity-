rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true || 
        request.auth.token.email == "concierge@9vives.com" ||
        request.auth.token.email == "admin@9vives.com"
      );
    }

    // 1. Centralized Store Settings (settings/store)
    match /settings/store {
      // Anyone can read store settings (brandName, logo, currency, SEO, colors)
      allow read: if true;
      // Only authenticated admins can update store settings
      allow write: if isAdmin();
    }

    // 2. Product Catalog (products/{productId})
    match /products/{productId} {
      // Anyone can view 9 Vives product catalog
      allow read: if true;
      // Only admins can create, edit, or delete products
      allow create, update, delete: if isAdmin();
    }

    // 3. Categories & Collections (categories/{categoryId})
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Customer Orders (orders/{orderId})
    match /orders/{orderId} {
      // Anyone can place an order at checkout
      allow create: if request.resource.data.items != null 
                    && request.resource.data.customerName != null
                    && request.resource.data.phone != null;
      
      // Customers can read their own order details, admins can view all orders
      allow read: if isAdmin() || (
        request.auth != null && (
          request.auth.token.email == resource.data.email || 
          request.auth.uid == resource.data.userId
        )
      );

      // Only admins can update order status (Pending, Processing, Shipped, Delivered)
      allow update, delete: if isAdmin();
    }

    // 5. Customer Profiles (users/{userId})
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

  }
}
